diff --git a/brain/src/brain/supervisor.py b/brain/src/brain/supervisor.py
new file mode 100644
index 0000000..9c2bfc4
--- /dev/null
+++ b/brain/src/brain/supervisor.py
@@ -0,0 +1,94 @@
+"""Starts and stops the camera / microphone monitors so they FOLLOW the plugin's switches (Keypad keys or settings page).
+
+Run it once (`app.py --auto`, see docs/AUTO.md): when you switch Pomodoro on, the gaze tracking (desk presence, pause / resume) and the on-screen timer
+start by themselves; switch it off and they stop. Same idea for the others:
+
+  switch                                  monitor that runs
+  Pomodoro on  or  Volume when far on     "gaze"   (Gaze Tracker -> presence, face size; the timer chip shows the plugin's clock)
+  Speech speed or Speech volume on        "pace"   (microphone)             only when you gave --mic
+  Person behind on                        "behind" (infrared camera)        only when you gave --ir-device
+  master switch off                       nothing runs
+Eye blinking is NOT managed: the camera's AI overheats after ~10 minutes, so it stays a manual `--device N` start.
+"""
+import time
+
+DEFAULT_ON = {"speed": True, "volume": True, "blink": True, "distance": True, "behind": True, "pomodoro": False}
+
+
+def read_switches(coach):
+    """The plugin's switches as {'master': bool, 'features': {id: bool}}, or None when the plugin does not answer (then nothing changes)."""
+    pom = coach.get_json("/pomodoro", timeout_s=0.8)
+    if pom is None:
+        return None
+    ui = coach.get_json("/ui-state", timeout_s=0.8)
+    ui = ui if isinstance(ui, dict) else {}
+    feats = {}
+    for fid, default in DEFAULT_ON.items():
+        node = ((ui.get("features") or {}).get(fid) or {}).get("enabled")
+        feats[fid] = node if isinstance(node, bool) else default
+    feats["pomodoro"] = bool(pom.get("active"))                 # the plugin's own clock is the truth for Pomodoro (Keypad key or page)
+    master = ui.get("master")
+    return {"master": master if isinstance(master, bool) else True, "features": feats}
+
+
+def wanted(sw, available):
+    """Names of the monitors that should run for these switches."""
+    if not sw["master"]:
+        return set()
+    f = sw["features"]
+    want = set()
+    if f["pomodoro"] or f["distance"]:
+        want.add("gaze")
+    if (f["speed"] or f["volume"]) and "pace" in available:
+        want.add("pace")
+    if f["behind"] and "behind" in available:
+        want.add("behind")
+    return want
+
+
+class Supervisor:
+    def __init__(self, read, start, stop, is_alive, available, say=print, retry_s=15.0, clock=time.monotonic):
+        self.read, self._start, self._stop, self.is_alive = read, start, stop, is_alive
+        self.available, self.say, self.retry_s, self.clock = set(available), say, retry_s, clock
+        self._started = set()
+        self._died_at = {}
+
+    def step(self):
+        sw = self.read()
+        if sw is None:                       # plugin not answering (restarting?): change nothing
+            return
+        want = wanted(sw, self.available)
+        now = self.clock()
+        for name in sorted(want):
+            if self.is_alive(name):
+                self._died_at.pop(name, None)
+                continue
+            died = self._died_at.get(name)
+            if name in self._started and died is None:           # it ended by itself (error, camera gone ...)
+                self._died_at[name] = now
+                self.say(f"the {name} monitor stopped by itself; trying again in {self.retry_s:.0f} s")
+                continue
+            if died is not None and now - died < self.retry_s:
+                continue
+            self._died_at.pop(name, None)
+            self._started.add(name)
+            self.say(f"switches say '{name}' is needed -> starting it")
+            self._start(name)
+        for name in sorted(self._started - want):
+            self.say(f"'{name}' is not needed any more -> stopping it")
+            self._stop(name)
+            self._started.discard(name)
+            self._died_at.pop(name, None)
+
+    def stop_all(self):
+        for name in sorted(self._started):
+            self._stop(name)
+        self._started.clear()
+
+    def loop(self, stop_event, every_s=2.0):
+        try:
+            self.step()
+            while not stop_event.wait(every_s):
+                self.step()
+        finally:
+            self.stop_all()
diff --git a/brain/tests/test_supervisor.py b/brain/tests/test_supervisor.py
new file mode 100644
index 0000000..e52b42f
--- /dev/null
+++ b/brain/tests/test_supervisor.py
@@ -0,0 +1,112 @@
+"""Run: cd brain && uv run python tests/test_supervisor.py"""
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
+from brain.supervisor import DEFAULT_ON, Supervisor, read_switches, wanted  # noqa: E402
+
+
+def sw(master=True, **features):
+    f = dict(DEFAULT_ON)
+    f.update(features)
+    return {"master": master, "features": f}
+
+
+class Rig:
+    def __init__(self, available=("gaze", "pace", "behind")):
+        self.state, self.alive, self.log, self.now = sw(), set(), [], 0.0
+        self.sup = Supervisor(lambda: self.state, self.start, self.stop, lambda n: n in self.alive, available, say=lambda m: None,
+                              retry_s=15.0, clock=lambda: self.now)
+
+    def start(self, n):
+        self.alive.add(n)
+        self.log.append("start " + n)
+
+    def stop(self, n):
+        self.alive.discard(n)
+        self.log.append("stop " + n)
+
+
+def test_wanted():
+    A = {"gaze", "pace", "behind"}
+    assert wanted(sw(distance=False, speed=False, volume=False, behind=False), A) == set()
+    assert wanted(sw(distance=False, speed=False, volume=False, behind=False, pomodoro=True), A) == {"gaze"}
+    assert wanted(sw(), A) == {"gaze", "pace", "behind"}                     # defaults: everything but Pomodoro
+    assert wanted(sw(), {"gaze"}) == {"gaze"}                                # no --mic / --ir-device given: only the gaze monitor can run
+    assert wanted(sw(master=False, pomodoro=True), A) == set()               # master off: nothing runs
+
+
+def test_pomodoro_on_starts_gaze_and_off_stops_it():
+    r = Rig()
+    r.state = sw(distance=False, speed=False, volume=False, behind=False)
+    r.sup.step()
+    assert r.log == []
+    r.state = sw(distance=False, speed=False, volume=False, behind=False, pomodoro=True)     # the Keypad key is pressed
+    r.sup.step()
+    r.sup.step()
+    assert r.log == ["start gaze"]                                                            # started once, not on every poll
+    r.state = sw(distance=False, speed=False, volume=False, behind=False)
+    r.sup.step()
+    assert r.log == ["start gaze", "stop gaze"] and not r.alive
+
+
+def test_plugin_not_answering_changes_nothing():
+    r = Rig()
+    r.state = sw(pomodoro=True)
+    r.sup.step()
+    before = list(r.log)
+    r.state = None
+    r.sup.step()
+    assert r.log == before and r.alive == {"gaze", "pace", "behind"}
+
+
+def test_a_monitor_that_dies_is_restarted_after_the_wait_not_in_a_loop():
+    r = Rig(available=("gaze",))
+    r.state = sw(distance=False, speed=False, volume=False, behind=False, pomodoro=True)
+    r.sup.step()
+    r.alive.clear()                                                           # it crashed
+    r.now = 1.0
+    r.sup.step()
+    assert r.log == ["start gaze"]                                            # noticed, waiting
+    r.now = 10.0
+    r.sup.step()
+    assert r.log == ["start gaze"]
+    r.now = 17.0
+    r.sup.step()
+    assert r.log == ["start gaze", "start gaze"]
+
+
+def test_master_off_stops_everything_and_stop_all():
+    r = Rig()
+    r.sup.step()
+    assert r.alive == {"gaze", "pace", "behind"}
+    r.state = sw(master=False)
+    r.sup.step()
+    assert not r.alive
+    r.state = sw()
+    r.sup.step()
+    r.sup.stop_all()
+    assert not r.alive
+
+
+class FakeCoach:
+    def __init__(self, answers):
+        self.answers = answers
+
+    def get_json(self, path, timeout_s=0.4):
+        return self.answers.get(path)
+
+
+def test_read_switches():
+    assert read_switches(FakeCoach({})) is None
+    s = read_switches(FakeCoach({"/pomodoro": {"active": True}, "/ui-state": {"master": True, "features": {"speed": {"enabled": False}, "pomodoro": {"enabled": False}}}}))
+    assert s["features"]["pomodoro"] is True and s["features"]["speed"] is False and s["features"]["volume"] is True and s["master"] is True
+    s = read_switches(FakeCoach({"/pomodoro": {"active": False}}))                    # page never opened: no ui-state
+    assert s["features"]["pomodoro"] is False and s["features"]["distance"] is True
+
+
+if __name__ == "__main__":
+    for n, f in list(globals().items()):
+        if n.startswith("test_"):
+            f()
+            print("ok", n)
diff --git a/docs/AUTO.md b/docs/AUTO.md
new file mode 100644
index 0000000..4376cdc
--- /dev/null
+++ b/docs/AUTO.md
@@ -0,0 +1,24 @@
+# One start, then the Keypad decides (`app.py --auto`)
+
+Start the launcher once; it WATCHES the plugin's switches (Keypad keys or settings page, polled every 2 s) and starts / stops the monitors itself:
+
+| Switch | What runs | Needs |
+|---|---|---|
+| Pomodoro on **or** Volume when far on | gaze monitor (Gaze Tracker -> desk presence, pause / resume, face size) and the on-screen timer chip (it shows only while the Pomodoro is on) | Gaze Tracker app running + calibrated |
+| Speech speed **or** Speech volume on | microphone monitor (snail, duck) | `--mic N` |
+| Person behind on | infrared-camera monitor | `--ir-device N` |
+| Master switch off | nothing | |
+| Eye blinking | **not managed**: the camera's AI overheats after ~10 min, so blink stays a manual `app.py --device N` start | |
+
+```
+cd brain
+uv run python src/brain/app.py --auto --mic 11 --ir-device 2
+```
+(`--list` shows the numbers; leave `--mic` / `--ir-device` out and those features simply are not started.) Press the Pomodoro key on the Keypad: the timer chip appears, presence flows, the
+clock pauses when you leave. Press it again: the gaze monitor stops. A monitor that crashes is retried after 15 s. If the plugin does not answer (Options+ restarting), nothing is changed.
+Ctrl+C stops everything. Tests: `brain/tests/test_supervisor.py`.
+
+# The Alert light key
+The ninth Desk Coach key is a switch for ALL alerts: **ALERTS ON** (green) / **ALERTS OFF** (red). Off = the policy drops every alert (mouse, Keypad, screen, sound), also person behind and time
+warnings; the features keep running (Pomodoro clock, volume when far). Stored in `settings.json` (`alertsOn`), so it survives a restart. Only forced test triggers (`--force`) still show.
+While an alert is showing, any key press dismisses it (it does not toggle), so to switch alerts off during an alert press twice.
